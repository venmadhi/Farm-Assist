    "_quick_wilt_note": "Quick Wilt (Phytophthora capsici systemic wilt) is NOT present in this dataset. 'phytophthora' here refers to Phytophthora leaf blight — a foliar disease, distinct from the systemic Quick Wilt syndrome. Do NOT merge these."
  },

  "_excluded_diseases": {
    "pepper_quick_wilt": {
      "reason": "No dataset contains a reliable Quick Wilt / Phytophthora capsici systemic wilt class. This disease is kept as a DEMO SIMULATION only in the FarmAssist UI and will not be predicted by the ConvGeM-NeXt classifier.",
      "note": "pepper_phytophthora_blight from the Pepper Bell dataset is a different manifestation and should NOT be displayed as Quick Wilt."
    }
