    "_note": "Pepper Bell Leaf Disease Dataset (Mendeley). Six categories. pepper_bacterial_spot merges with PlantVillage entry; others are new classes.",
    "Bacterial_spot":                         "pepper_bacterial_spot",
    "cercospora":                             "pepper_cercospora",
    "curl":                                   "pepper_leaf_curl",
    "healthy":                                "pepper_healthy",
